# dentaldistill 环境变量示例。复制为 setup.env 并填写。
# cp setup.env.example setup.env

# Python 解释器（含 torch/transformers/peft）
EASYEDIT_PY=/home/student/anaconda3/bin/python3

# 模型路径
BASE_MODEL_14B=/home/student/arthas/mentalDistill/models/Qwen2.5-14B-Instruct
BASE_MODEL_32B=/home/student/arthas/mentalDistill/models/Qwen2.5-32B-Instruct
BASE_MODEL_QWEN3_32B=/home/student/arthas/mentalDistill/models/Qwen3-32B
BASE_MODEL_LLAMA70B=/home/student/arthas/mentalDistill/models/Llama-3.3-70B-Instruct

# 教师 API（中文全科/牙科的 DeepSeek-V4-flash = deepseek-chat）
